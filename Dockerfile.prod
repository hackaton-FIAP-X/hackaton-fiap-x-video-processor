# WRK-9 — imagem de producao do worker: multi-stage, JRE, FFmpeg e usuario nao-root.
#
# Base Debian/Ubuntu (jammy) de proposito: o FFmpeg do Alpine costuma dar dor de
# cabeca com codecs e musl. A imagem fica maior, mas previsivel.
FROM maven:3.9-eclipse-temurin-21 AS build

WORKDIR /build

COPY pom.xml .
RUN mvn -B -q dependency:go-offline

COPY src ./src
RUN mvn -B -q clean package -DskipTests -Dspotless.check.skip=true -Djacoco.skip=true \
    && java -Djarmode=layertools -jar target/video-processor-*.jar extract --destination layers


FROM eclipse-temurin:21-jre-jammy AS runtime

RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg curl \
    && rm -rf /var/lib/apt/lists/* \
    && ffmpeg -version | head -1

# UID/GID fixos e numericos: o Kubernetes (runAsNonRoot + runAsUser 10001) consegue
# provar que nao e root. Os videos sao processados em /tmp.
RUN groupadd --system --gid 10001 fiapx \
    && useradd --system --uid 10001 --gid fiapx --no-create-home fiapx

WORKDIR /app

COPY --from=build --chown=fiapx:fiapx /build/layers/dependencies/ ./
COPY --from=build --chown=fiapx:fiapx /build/layers/spring-boot-loader/ ./
COPY --from=build --chown=fiapx:fiapx /build/layers/snapshot-dependencies/ ./
COPY --from=build --chown=fiapx:fiapx /build/layers/application/ ./

USER 10001

EXPOSE 8082

HEALTHCHECK --interval=15s --timeout=3s --start-period=45s --retries=3 \
    CMD curl -fsS http://localhost:8082/actuator/health/liveness || exit 1

ENTRYPOINT ["java", "-XX:MaxRAMPercentage=75.0", "-XX:+ExitOnOutOfMemoryError", \
    "org.springframework.boot.loader.launch.JarLauncher"]
